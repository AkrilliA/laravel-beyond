{
    "name": "akrillia/laravel-beyond",
    "type": "library",
    "license": "ISC",
    "version": "7.1.0",
    "autoload": {
        "psr-4": {
            "AkrilliA\\LaravelBeyond\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Jonas Regner",
            "email": "regnerjonas@protonmail.com"
        },
        {
            "name": "Alexander Gaal",
            "email": "alexander.gaal@gipfel.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-fileinfo": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/filesystem": "^11.0|^12.0",
        "laravel/prompts": "^v0.3.5"
    },
    "extra": {
        "laravel": {
            "providers": [
                "AkrilliA\\LaravelBeyond\\LaravelBeyondServiceProvider"
            ]
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^v11.0",
        "orchestra/testbench": "^9.1|^10.1",
        "laravel/pint": "^v1.21",
        "spatie/laravel-query-builder": "^6.3.1",
        "spatie/laravel-data": "^4.13",
        "spatie/laravel-queueable-action": "^2.16",
        "phpstan/phpstan": "^2.1"
    },
    "minimum-stability": "dev"
}
